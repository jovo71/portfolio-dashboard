# Portfolio Dashboard Omgevingsvariabelen
# Kopieer dit bestand naar .env en pas de waarden aan

# Veiligheidssleutel (verander dit!)
SECRET_KEY=verander-dit-in-een-lang-willekeurig-geheim

# Koersupdate tijden
UPDATE_TIME_1=08:00
UPDATE_TIME_2=13:00

# JWT token verlooptijd in minuten (standaard 24 uur)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (standaard SQLite)
DATABASE_URL=sqlite:////app/data/portfolio.db
